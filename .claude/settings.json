{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "fab0": {
      "source": {
        "source": "github",
        "repo": "fab0-dev/fab0-core",
        "ref": "fab0--v0.3.0"
      }
    }
  },
  "enabledPlugins": {
    "fab0@fab0": true
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * -f)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Edit(/.github/**)"
    ]
  }
}
